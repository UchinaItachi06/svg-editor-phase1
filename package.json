{
  "name": "svg-editor-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run format:check && npm test",
    "format": "prettier --write src test package.json tsconfig.json",
    "format:check": "prettier --check src test package.json tsconfig.json"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
